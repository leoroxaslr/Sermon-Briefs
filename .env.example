# Copy this file to .env.local and fill in your key.
# .env.local is git-ignored: never commit real keys.

# Tavily API key (https://app.tavily.com). Leave blank to use the free local engine only.
TAVILY_API_KEY=

# Tavily Research model: "mini" (4-110 credits per brief) or "pro" (15-250 credits).
TAVILY_RESEARCH_MODEL=mini
